<enclosure url="https://substackcdn.com/image/fetch/$s_!LvUn!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Faa8726ad-ab6c-4a0c-81b0-c8ce619d0b58_4939x3339.jpeg" length="0" type="image/jpeg"/>
