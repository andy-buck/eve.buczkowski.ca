<enclosure url="https://substackcdn.com/image/fetch/f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7c76110c-e508-4f7a-a0d4-22022e062e6c_1767x2356.jpeg" length="0" type="image/jpeg"/>
