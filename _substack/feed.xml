a-9cbf58fbd28d_4032x3024.jpeg 848w, https://substackcdn.com/image/fetch/$s_!xZ-r!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fd66154e3-8709-4fff-888a-9cbf58fbd28d_4032x3024.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!xZ-r!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fd66154e3-8709-4fff-888a-9cbf58fbd28d_4032x3024.jpeg 1456w" sizes="100vw" loading="lazy"></picture><div class="image-link-expand"><div class="pencraft pc-display-flex pc-gap-8 pc-reset"><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container restack-image buttonBase-GK1x3M"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke-width="1.5" stroke="var(--color-fg-primary)" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" class="icon-noB79L"><g><path d="M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882"></path></g></svg></button><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container view-image buttonBase-GK1x3M"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize2 lucide-maximize-2 icon-noB79L"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" x2="14" y1="3" y2="10"></line><line x1="3" x2="10" y1="21" y2="14"></line></svg></button></div></div></div></a></figure></div><p></p><div><hr></div><h3>Selected to Represent Canada &#8211; 2025 Track World Championships, Apeldoorn, Netherlands</h3><p>One of the biggest moments of my cycling career so far happened this month: I was officially selected to represent Canada at the 2025 UCI Junior Track World Championships in Apeldoorn, Netherlands. This has been a goal of mine since I started racing, and it&#8217;s truly an honour to be chosen to wear the maple leaf on the world stage. I&#8217;ll be competing against the fastest female junior riders in the world later this summer, and I can&#8217;t wait to give it everything I&#8217;ve got. Huge thanks to my coaches, teammates, and of course my sponsors, this wouldn't be possible without your continued support. As of now, the races I will be competing in are elimination and the individual pursuit with the opportunity to secure a spot in the team pursuit and madison events at the preparation camp in Bromont, Quebec. </p><div class="captioned-image-container"><figure><a class="image-link image2 is-viewable-img" target="_blank" href="https://substackcdn.com/image/fetch/$s_!SGwB!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F3a3856e8-f966-4ae5-921f-5806f86db4f2_4032x3024.jpeg" data-component-name="Image2ToDOM"><div class="image2-inset"><picture><source type="image/webp" srcset="https://substackcdn.com/image/fetch/$s_!SGwB!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F3a3856e8-f966-4ae5-921f-5806f86db4f2_4032x3024.jpeg 424w, https://substackcdn.com/image/fetch/$s_!SGwB!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F3a3856e8-f966-4ae5-921f-5806f86db4f2_4032x3024.jpeg 848w, https://substackcdn.com/image/fetch/$s_!SGwB!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F3a3856e8-f966-4ae5-921f-