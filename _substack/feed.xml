<enclosure url="https://substackcdn.com/image/fetch/f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Ff3d8cfe8-694e-44ef-84a3-fb015b74d58a_4032x3024.jpeg" length="0" type="image/jpeg"/>
