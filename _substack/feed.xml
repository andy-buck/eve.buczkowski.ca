f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F0aaac57e-2e57-42eb-95ec-0f27293fb26b_2000x1600.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!LzKN!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F0aaac57e-2e57-42eb-95ec-0f27293fb26b_2000x1600.jpeg 1456w" sizes="100vw" loading="lazy"></picture><div class="image-link-expand"><div class="pencraft pc-display-flex pc-gap-8 pc-reset"><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container restack-image buttonBase-GK1x3M"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke-width="1.5" stroke="var(--color-fg-primary)" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" class="icon-noB79L"><g><path d="M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882"></path></g></svg></button><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container view-image buttonBase-GK1x3M"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize2 lucide-maximize-2 icon-noB79L"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" x2="14" y1="3" y2="10"></line><line x1="3" x2="10" y1="21" y2="14"></line></svg></button></div></div></div></a></figure></div><p>Photo Credits: @sbreau.photography on Instagram</p><div><hr></div><h3>O-Cup #2 &#8211; June 8, 2025 &#8211; Moonstone, ON</h3><p>Coming just a week after Charlevoix, Ontario Cup #2 was another tough race, especially with fatigue still lingering in my legs. This was a hilly and technical 87km course with 1,100m of elevation, and I knew it would be a real test of resilience, but I was ready to rise to the challenge.</p><div class="captioned-image-container"><figure><a class="image-link image2 is-viewable-img" target="_blank" href="https://substackcdn.com/image/fetch/$s_!Wft9!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F22e1b395-6260-4ec0-8249-bf2f89642db9_4032x3024.jpeg" data-component-name="Image2ToDOM"><div class="image2-inset"><picture><source type="image/webp" srcset="https://substackcdn.com/image/fetch/$s_!Wft9!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F22e1b395-6260-4ec0-8249-bf2f89642db9_4032x3024.jpeg 424w, https://substackcdn.com/image/fetch/$s_!Wft9!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F22e1b395-6260-4ec0-8249-bf2f89642db9_4032x3024.jpeg 848w, https://substackcdn.com/image/fetch/$s_!Wft9!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F22e1b395-6260-4ec0-8249-bf2f89642db9_4032x3024.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!Wft9!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F22e1b395-6260-4ec0-8249-bf2f89642db9_4032x3024.jpeg 1456w" sizes="100vw"><img src="https://substackcdn.com/image/fetch/$s_!Wft9!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F22e1b395-6260-4ec0-8249-bf2f89642db9_4032x3024.jpeg" width="480" height="639.8901098901099" data-attrs="{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/22e1b395-6260-4ec0-8249-bf2f89642db9_4032x3024.jpeg&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:1941,&quot;width&quot;:1456,&quot;resizeWidth&quot;:480,&quot;bytes&quot;:5459416,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/jpeg&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://evetbuczkowski.substack.com/i/165564072?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F22e1b395-6260-4ec0-8249-bf2f89642db9_4032x3024.jpeg&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}" class="sizing-normal" alt="" srcset="https://substackcdn.com/image/fetch/$s_!Wft9!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F22e1b395-6260-4ec0-8249-bf2f89642db9_4032x3024.jpeg 424w, https://substackcdn.com/image/fetch/$s_!Wft9!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F22e1b395-6260-4ec0-8249-bf2f89642db9_4032x3024.jpeg 848w, https://substackcdn.com/image/fetch/$s_!Wft9!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F22e1b395-6260-4ec0-8249-bf2f89642db9_4032x3024.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!Wft9!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F22e1b395-6260-4ec0-8249-bf2f89642db9_4032x3024.jpeg 1456w" sizes="100vw" loading="lazy"></picture><div class="image-link-expand"><div class="pencraft pc-display-flex pc-gap-8 pc-reset"><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container restack-image buttonBase-GK1x3M"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke-width="1.5" stroke="var(--color-fg-primary)" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" class="icon-noB79L"><g><path d="M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882"></path></g></svg></button><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container view-image buttonBase-GK1x3M"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize2 lucide-maximize-2 icon-noB79L"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" x2="14" y1="3" y2="10"></line><line x1="3" x2="10" y1="21" y2="14"></line></svg></button></div></div></div></a></figure></div><p>One of the best parts of the day was how well I was able to work with my teammates. Through strong communication and strategy, we executed our race plan effectively and it paid off. Two of my teammates made the podium, placing 2nd and 3rd, and I crossed the line in 5th, securing a solid result for myself as well. It was incredibly satisfying to be part of such a strong team performance and helping my teammates get on the podium made the day even more rewarding. This race reminded me that cycling is not only about individual strength but also about teamwork, trust, and execution. I left Moonstone with confidence, momentum, and even more motivation heading into Canadian Road Nationals.</p><div><hr></div><h3>Training Every Day &#8211; Progress &amp; Reflection</h3><p>Between race weekends, I&#8217;ve been focused on consistent, high-quality training sessions that help me stay sharp and race ready. I&#8217;m on the bike every single day, with a mixture of long endurance efforts with high-intensity sessions. Two of the most valuable parts of my week have been the LCW (London Centennial Wheelers) Tuesday Night Criteriums and Thursday Time Trials, which offer perfect race like environments to test tactics, pacing, and fitness. The crits give me a chance to practice aggressive, high speed racing in a tight pack, while the time trials help me zero in on pacing, aero position, and sustained power. Training with groups of people like them really help towards building my results in races such as Charlevoix and I truly appreciate the volunteer based events that they are able to put on weekly.  </p><div class="captioned-image-container"><figure><a class="image-link image2 is-viewable-img" target="_blank" href="https://substackcdn.com/image/fetch/$s_!7JGD!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F28f136b9-e7a6-43cc-bd15-2136a51d747c_1200x1600.jpeg" data-component-name="Image2ToDOM"><div class="image2-inset"><picture><source type="image/webp" srcset="https://substackcdn.com/image/fetch/$s_!7JGD!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F28f136b9-e7a6-43cc-bd15-2136a51d747c_1200x1600.jpeg 424w, https://substackcdn.com/image/fetch/$s_!7JGD!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F28f136b9-e7a6-43cc-bd15-2136a51d747c_1200x1600.jpeg 848w, https://substackcdn.com/image/fetch/$s_!7JGD!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F28f136b9-e7a6-43cc-bd15-2136a51d747c_1200x1600.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!7JGD!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F28f136b9-e7a6-43cc-bd15-2136a51d747c_1200x1600.jpeg 1456w" sizes="100vw"><img src="https://substackcdn.com/image/fetch/$s_!7JGD!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F28f136b9-e7a6-43cc-bd15-2136a51d747c_1200x1600.jpeg" width="470" height="626.6666666666666" data-attrs="{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/28f136b9-e7a6-43cc-bd15-2136a51d747c_1200x1600.jpeg&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:1600,&quot;width&quot;:1200,&quot;resizeWidth&quot;:470,&quot;bytes&quot;:331827,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/jpeg&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://evetbuczkowski.substack.com/i/165564072?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F28f136b9-e7a6-43cc-bd15-2136a51d747c_1200x1600.jpeg&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}" class="sizing-normal" alt="" srcset="https://substackcdn.com/image/fetch/$s_!7JGD!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F28f136b9-e7a6-43cc-bd15-2136a51d747c_1200x1600.jpeg 424w, https://substackcdn.com/image/fetch/$s_!7JGD!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F28f136b9-e7a6-43cc-bd15-2136a51d747c_1200x1600.jpeg 848w, https://substackcdn.com/image/fetch/$s_!7JGD!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F28f136b9-e7a6-43cc-bd15-2136a51d747c_1200x1600.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!7JGD!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F28f136b9-e7a6-43cc-bd15-2136a51d747c_1200x1600.jpeg 1456w" sizes="100vw" loading="lazy"></picture><div class="image-link-expand"><div class="pencraft pc-display-flex pc-gap-8 pc-reset"><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container restack-image buttonBase-GK1x3M"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke-width="1.5" stroke="var(--color-fg-primary)" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" class="icon-noB79L"><g><path d="M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882"></path></g></svg></button><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container view-image buttonBase-GK1x3M"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize2 lucide-maximize-2 icon-noB79L"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" x2="14" y1="3" y2="10"></line><line x1="3" x2="10" y1="21" y2="14"></line></svg></button></div></div></div></a></figure></div><p></p><p>These weekly efforts have made a big difference, not just physically, but mentally too. I&#8217;ve developed a better sense of race timing, learned how to stay calm under pressure, and working through race tactics. Looking back on my past few races, I can see how much I&#8217;ve grown. I truly feel like I&#8217;m in one of the strongest and smartest places I&#8217;ve  been, and I&#8217;m excited to see that progress continue heading into Road Nationals and the second half of the season.</p><div><hr></div><h3>Support My Journey &#8211; GoFundMe Launched</h3><p>In May, I also launched a GoFundMe campaign to help cover the costs associated with competing at the 2025 UCI Junior Track World Championships in Apeldoorn, Netherlands later this summer. This is a massive opportunity and a dream come true, but international racing comes with big expenses, travel, gear, accommodations, and registration fees.</p><p>If you&#8217;re able, I would be so grateful for any support you can offer, whether it&#8217;s a donation or simply sharing the link with your network. Every contribution brings me one step closer to competing on the world stage and proudly representing Canada. You can check out the campaign here!</p><p><a href="https://gofund.me/e5c364af">GoFundMe - Junior Track World Championships, Apeldoorn, Netherlands</a></p><div class="captioned-image-container"><figure><a class="image-link image2 is-viewable-img" target="_blank" href="https://substackcdn.com/image/fetch/$s_!HZgf!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcab795df-1968-4a94-8432-2e64b3da6058_828x613.jpeg" data-component-name="Image2ToDOM"><div class="image2-inset"><picture><source type="image/webp" srcset="https://substackcdn.com/image/fetch/$s_!HZgf!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcab795df-1968-4a94-8432-2e64b3da6058_828x613.jpeg 424w, https://substackcdn.com/image/fetch/$s_!HZgf!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcab795df-1968-4a94-8432-2e64b3da6058_828x613.jpeg 848w, https://substackcdn.com/image/fetch/$s_!HZgf!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcab795df-1968-4a94-8432-2e64b3da6058_828x613.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!HZgf!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcab795df-1968-4a94-8432-2e64b3da6058_828x613.jpeg 1456w" sizes="100vw"><img src="https://substackcdn.com/image/fetch/$s_!HZgf!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcab795df-1968-4a94-8432-2e64b3da6058_828x613.jpeg" width="486" height="359.80434782608694" data-attrs="{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/cab795df-1968-4a94-8432-2e64b3da6058_828x613.jpeg&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:613,&quot;width&quot;:828,&quot;resizeWidth&quot;:486,&quot;bytes&quot;:183914,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/jpeg&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://evetbuczkowski.substack.com/i/165564072?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcab795df-1968-4a94-8432-2e64b3da6058_828x613.jpeg&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}" class="sizing-normal" alt="" srcset="https://substackcdn.com/image/fetch/$s_!HZgf!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcab795df-1968-4a94-8432-2e64b3da6058_828x613.jpeg 424w, https://substackcdn.com/image/fetch/$s_!HZgf!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcab795df-1968-4a94-8432-2e64b3da6058_828x613.jpeg 848w, https://substackcdn.com/image/fetch/$s_!HZgf!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcab795df-1968-4a94-8432-2e64b3da6058_828x613.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!HZgf!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fcab795df-1968-4a94-8432-2e64b3da6058_828x613.jpeg 1456w" sizes="100vw" loading="lazy"></picture><div class="image-link-expand"><div class="pencraft pc-display-flex pc-gap-8 pc-reset"><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container restack-image buttonBase-GK1x3M"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke-width="1.5" stroke="var(--color-fg-primary)" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" class="icon-noB79L"><g><path d="M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882"></path></g></svg></button><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container view-image buttonBase-GK1x3M"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize2 lucide-maximize-2 icon-noB79L"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" x2="14" y1="3" y2="10"></line><line x1="3" x2="10" y1="21" y2="14"></line></svg></button></div></div></div></a></figure></div><p></p><p>Thank you so much for believing in me and for continuing to be part of this journey. I truly appreciate anyone who has donated towards helping me achieve my dreams. </p><div><hr></div><h3>Your Contributions</h3><p>Here&#8217;s a quick look of where your contributions have gone this past month and how they&#8217;re helping me continue this journey:</p><ul><li><p><strong>Ontario Cup #2 &#8211; Moonstone, ON</strong>: <strong>$185 </strong><em>(entry and accommodations)</em></p></li><li><p><strong>Flights to Junior Track Worlds - Apeldoorn, NL: $1,600</strong></p></li><li><p><strong>Team Fees - $2,500</strong></p></li></ul><p><strong>Total: $4,285.00</strong></p><p>Your generosity directly supports my ability to attend and compete in these events, giving me the chance to grow, gain experience, and push my potential. Thank you again for making this possible.</p><div><hr></div><h3>What&#8217;s Next</h3><p>The next few months are packed with big goals and bigger races. I&#8217;m focused and training hard, and I&#8217;m so excited to take everything I&#8217;ve learned so far this year into the next phase of competition.</p><p>Here&#8217;s what&#8217;s coming up:</p><ul><li><p><strong>Canadian Road Nationals</strong> &#8211; June 24 &#8594; June 30, 2025 &#8211; Beauce, QC</p></li><li><p><strong>Tour de l'Abitibi F&#233;minin</strong> <strong>(UCI Nations Cup) </strong>&#8211; July 11 &#8594; July 14, 2025 &#8211; Val-d&#8217;Or, QC</p></li><li><p><strong>Chicago Grit</strong> &#8211; July 18 &#8594; July 27, 2025 &#8211; Chicago, IL</p></li><li><p><strong>Track Worlds Preparation Camp</strong> &#8211; August 6 &#8594; August 16, 2025 &#8211; Bromont, QC</p></li><li><p><strong>UCI Junior Track Worlds</strong> - August 20 &#8594; August 24, 2025 - Apeldoorn, Netherlands</p></li></ul><p>Thank you again for being in my corner. Your belief in me is what drives this entire journey forward, and I can&#8217;t wait to continue sharing the ride with you.</p><p><br><strong>Eve Buczkowski</strong><br>U19 Road &amp; Track Cyclist | Team Canada &amp; Milton Revolution U23 Project</p><div class="subscription-widget-wrap-editor" data-attrs="{&quot;url&quot;:&quot;https://evetbuczkowski.substack.com/subscribe?&quot;,&quot;text&quot;:&quot;Subscribe&quot;,&quot;language&quot;:&quot;en&quot;}" data-component-name="SubscribeWidgetToDOM"><div class="subscription-widget show-subscribe"><div class="preamble"><p class="cta-caption">Thanks for reading Chasing the Break: My Journey in Cycling! Subscribe for free to receive new posts and support my work.</p></div><form class="subscription-widget-subscribe"><input type="email" class="email-input" name="email" placeholder="Type your email&#8230;" tabindex="-1"><input type="submit" class="button primary" value="Subscribe"><div class="fake-input-wrapper"><div class="fake-input"></div><div class="fake-button"></div></div></form></div></div> ]]>
